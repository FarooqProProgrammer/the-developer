# Database MCP env (example — copy values into your user/shell env or Cursor secrets)
# Do not commit real credentials. Never put passwords in mcp.json.

# PostgreSQL (official read-only MCP: @modelcontextprotocol/server-postgres)
POSTGRES_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# MySQL (@benborla29/mcp-server-mysql — read-only by default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=DATABASE

# MongoDB (mongodb-mcp-server)
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/DATABASE
