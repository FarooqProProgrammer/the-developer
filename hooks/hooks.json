{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/codegraph-sync.js",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./scripts/frontend-mockup-first.js",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "node ./scripts/frontend-mockup-first.js",
        "matcher": "Write|StrReplace|Edit",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "node ./scripts/codegraph-sync.js",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "node ./scripts/codegraph-sync.js",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node ./scripts/regenerate-folder-structure.js",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "node ./scripts/regenerate-folder-structure.js",
        "timeout": 30
      }
    ]
  }
}
